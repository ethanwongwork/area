{
  "name": "@area/react",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "description": "Area React components. Contains no CSS.",
  "exports": {
    ".": {
      "types": "./dist/modules/index.d.ts",
      "import": "./dist/modules/index.js",
      "default": "./dist/modules/index.js"
    },
    "./variants": {
      "types": "./dist/modules/variants.d.ts",
      "import": "./dist/modules/variants.js",
      "default": "./dist/modules/variants.js"
    },
    "./theme": {
      "types": "./dist/modules/components/Theme.d.ts",
      "import": "./dist/modules/components/Theme.js",
      "default": "./dist/modules/components/Theme.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/build-modules.mjs .",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.3 || ^19"
  },
  "dependencies": {
    "@area/styles": "*",
    "@area/tokens": "*"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.7.0"
  }
}

{
  "name": "@area/tokens",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "description": "Area design tokens — OKLCH scale generator, axis registry, and CSS emitter.",
  "exports": {
    ".": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "default": "./dist/config.js"
    },
    "./tokens.json": "./dist/tokens.json",
    "./css/tokens.css": "./dist/css/tokens.css",
    "./css/axes.css": "./dist/css/axes.css",
    "./css/properties.css": "./dist/css/properties.css",
    "./css/*": "./dist/css/*",
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./types": {
      "types": "./dist/tokens.d.ts"
    },
    "./brand": {
      "types": "./dist/brand.d.ts",
      "import": "./dist/brand.js",
      "default": "./dist/brand.js"
    },
    "./color": {
      "types": "./dist/colours.d.ts",
      "import": "./dist/colours.js",
      "default": "./dist/colours.js"
    },
    "./colours": {
      "types": "./dist/colours.d.ts",
      "import": "./dist/colours.js",
      "default": "./dist/colours.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node src/build.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "preview": "node src/color/preview.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "colorjs.io": "^0.7.1",
    "typescript": "^5.7.0",
    "vitest": "^5.0.0",
    "apca-w3": "0.1.9"
  },
  "bin": {
    "area-tokens": "./dist/cli.js"
  }
}

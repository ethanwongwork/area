{
  "name": "@area/icons",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "description": "Area icons: one React component per icon (outline and filled), raw SVGs, a sprite and metadata.",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/modules/index.d.ts",
      "import": "./dist/modules/index.js",
      "default": "./dist/modules/index.js"
    },
    "./review": {
      "types": "./dist/modules/review.d.ts",
      "import": "./dist/modules/review.js",
      "default": "./dist/modules/review.js"
    },
    "./meta": {
      "types": "./dist/modules/meta.d.ts",
      "import": "./dist/modules/meta.js",
      "default": "./dist/modules/meta.js"
    },
    "./icons/*": {
      "types": "./dist/modules/generated/icons/*.d.ts",
      "import": "./dist/modules/generated/icons/*.js",
      "default": "./dist/modules/generated/icons/*.js"
    },
    "./icons.json": "./dist/icons.json",
    "./sprite.svg": "./dist/sprite.svg",
    "./rtl.css": "./rtl.css",
    "./svg/*": "./dist/svg/*"
  },
  "files": [
    "dist",
    "rtl.css",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs --package",
    "build": "npm run generate && node ../../scripts/build-modules.mjs . && node scripts/build-assets.mjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "node scripts/ensure-generated.mjs && tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.3 || ^19"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.7.0"
  }
}

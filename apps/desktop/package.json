{
  "name": "@area/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Area's desktop app: the gallery of every component, icon, type style and colour, in Electron.",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/build.mjs && electron .",
    "preview": "node scripts/dev.mjs --browser",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:playgrounds": "node scripts/check-playgrounds.mjs",
    "check:docs": "node scripts/check-docs.mjs"
  },
  "dependencies": {
    "@area/icons": "*",
    "@area/react": "*",
    "@area/styles": "*",
    "@area/tokens": "*"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "esbuild": "^0.25.0",
    "react": "^19",
    "react-dom": "^19"
  }
}

{
  "name": "area",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Area \u2014 an axis-driven design system.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @area/tokens && npm run build -w @area/styles && npm run build -w @area/react && npm run build -w @area/icons",
    "build:docs": "npm run build && npm run build -w @area/docs",
    "test": "npm run test -w @area/tokens",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint:manifest": "npm run lint:manifest -w @area/styles",
    "dev": "npm run dev -w @area/desktop",
    "preview": "npm run preview -w @area/desktop",
    "dev:docs": "npm run dev -w @area/docs",
    "clean": "rm -rf packages/*/dist apps/*/dist",
    "audit": "npm run audit -w @area/docs",
    "test:preview": "npm run test -w @area/docs",
    "test:consumer": "node scripts/check-consumer.mjs",
    "test:switch": "node --test packages/react/tests/switch.test.mjs",
    "test:slider": "node --test packages/react/tests/slider.test.mjs",
    "test:input-field": "node --test packages/react/tests/input-field.test.mjs",
    "test:badge": "node --test packages/react/tests/badge.test.mjs",
    "test:split-button": "node --test packages/react/tests/split-button.test.mjs",
    "test:dialog": "node --test packages/react/tests/dialog.test.mjs",
    "test:contracts": "node --test packages/styles/scripts/manifest-parity.test.mjs",
    "capture:compare": "node scripts/capture-compare.mjs",
    "audit:page": "node scripts/audit-page.mjs",
    "icons:pilot": "node packages/icons/scripts/generate.mjs",
    "icons:find": "node packages/icons/scripts/find.mjs",
    "icons:batch": "node packages/icons/scripts/batch.mjs",
    "icons:sheet": "node packages/icons/scripts/sheet.mjs",
    "icons:geometry": "node packages/icons/scripts/geometry.mjs",
    "icons:refs": "node packages/icons/scripts/refs.mjs",
    "icons:keywords": "node packages/icons/scripts/keywords.mjs",
    "lint:icons": "node packages/icons/scripts/generate.mjs --check",
    "test:icons": "npm test -w @area/icons",
    "test:desktop": "node --test apps/desktop/tests/*.test.ts"
  },
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || >=26.0.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  },
  "devDependencies": {
    "@fluentui/svg-icons": "^1.1.341",
    "esbuild": "^0.28.2"
  }
}

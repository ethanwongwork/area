{
  "name": "area",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Area \u2014 an axis-driven design system.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @area/tokens && npm run build -w @area/styles && npm run build -w @area/react",
    "build:docs": "npm run build && npm run build -w @area/docs",
    "test": "npm run test -w @area/tokens",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint:manifest": "npm run lint:manifest -w @area/styles",
    "dev": "npm run dev -w @area/docs",
    "clean": "rm -rf packages/*/dist apps/*/dist",
    "audit": "npm run audit -w @area/docs",
    "test:preview": "npm run test -w @area/docs",
    "test:consumer": "node scripts/check-consumer.mjs",
    "test:switch": "node --test packages/react/tests/switch.test.mjs",
    "test:slider": "node --test packages/react/tests/slider.test.mjs",
    "test:input-field": "node --test packages/react/tests/input-field.test.mjs",
    "test:badge": "node --test packages/react/tests/badge.test.mjs",
    "test:split-button": "node --test packages/react/tests/split-button.test.mjs",
    "test:dialog": "node --test packages/react/tests/dialog.test.mjs",
    "test:contracts": "node --test packages/styles/scripts/manifest-parity.test.mjs apps/docs/scripts/axis-preferences.test.mjs",
    "capture:compare": "node scripts/capture-compare.mjs",
    "audit:page": "node scripts/audit-page.mjs",
    "icons:pilot": "node apps/docs/scripts/gen-pilot-icons.mjs",
    "icons:find": "node apps/docs/scripts/icon-find.mjs",
    "icons:batch": "node apps/docs/scripts/icon-batch.mjs",
    "icons:sheet": "node apps/docs/scripts/icon-sheet.mjs",
    "icons:geometry": "node apps/docs/scripts/icon-geometry.mjs",
    "lint:icons": "node apps/docs/scripts/gen-pilot-icons.mjs --check"
  },
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || >=26.0.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  },
  "devDependencies": {
    "@fluentui/svg-icons": "^1.1.341",
    "esbuild": "^0.28.2"
  }
}
